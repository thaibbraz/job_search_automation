[Unit]
Description=Jobbyo job search — pass 1/2, 01:00 Asia/Jakarta
Requires=jobbyo-search.service

[Timer]
# Timezone-aware so this stays at 01:00 Jakarta all year (Jakarta has no DST).
OnCalendar=*-*-* 01:00:00 Asia/Jakarta
Persistent=true
Unit=jobbyo-search-run.service

[Install]
WantedBy=timers.target
